# Copy to .env and fill in. Never commit the real .env (see ../.gitignore).
#
# Default (recommended): an isolated local Postgres container, never real
# Neon/Blob production data — see README.md "Quick start (local dev)".
# DATABASE_URL below matches `docker run ... -p 5434:5432 ... postgres:16-alpine`.
# Leave BLOB_READ_WRITE_TOKEN empty to use local disk storage automatically.
#
# Only point this at real Neon/Blob (via `vercel env pull`) if you specifically
# need to test a production-only integration issue — doing so makes local dev
# write to the same data the live site reads (docs/phase9-technical-debt.md).

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/openfolklore_dev"
JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"
PORT=4000

# Comma-separated list of origins allowed to call the API in production.
CORS_ORIGIN="http://localhost:5173"

# Optional — only required if the speech-to-text stretch module (S-D) is enabled.
ASR_API_KEY=""

# Optional — omit to use local disk storage for audio uploads instead of Vercel Blob.
BLOB_READ_WRITE_TOKEN=""
